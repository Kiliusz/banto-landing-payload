# ─── Baza danych ────────────────────────────────────────────────────────────────
# Lokalnie: docker compose up -d postgres (patrz docker-compose.yml)
DATABASE_URL=postgres://banto:banto@127.0.0.1:5432/banto

# ─── Payload ────────────────────────────────────────────────────────────────────
# Sekret do podpisywania tokenów. Wygeneruj: openssl rand -base64 32
PAYLOAD_SECRET=zmien-mnie-na-losowy-ciag

# ─── URL serwisu ────────────────────────────────────────────────────────────────
# Bez ukośnika na końcu. Używane w metadataBase, sitemap.xml, og:image, live preview.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Podgląd wersji roboczych (draft preview) ───────────────────────────────────
# Wygeneruj: openssl rand -hex 16
PREVIEW_SECRET=zmien-mnie-tez

# ─── MailerLite (opcjonalnie) ───────────────────────────────────────────────────
# Jeśli puste, zapisy z formularza trafiają wyłącznie do kolekcji "Waitlist" w Payloadzie.
# Klucz: MailerLite → Integrations → Developer API.
MAILERLITE_API_KEY=
# ID grupy, do której dopisujemy subskrybenta (MailerLite → Subscribers → Groups).
MAILERLITE_GROUP_ID=

# ─── Basic auth (środowiska nieprodukcyjne) ─────────────────────────────────────
# Format: login:hasło. Ustawione = cały serwis (łącznie z /admin) chowa się
# za oknem logowania przeglądarki. Puste = brak zabezpieczenia.
STAGE_BASIC_AUTH=

# ─── Seed ───────────────────────────────────────────────────────────────────────
# Konto administratora zakładane przez `npm run seed`
SEED_ADMIN_EMAIL=admin@banto.pl
SEED_ADMIN_PASSWORD=
